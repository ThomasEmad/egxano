{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/cron/audit?type=daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/cron/audit?type=weekly",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/v1/cron/alerts-push",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/v1/cron/candles?run=1",
      "schedule": "35 13 * * 0-4"
    }
  ]
}