// --- Subscription / Auth layer (added for Free + Premium model) ---

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Nullable since OAuth sign-ups (Google/Facebook) have no local password —
  // they can only sign in via the provider (or set a password later).
  passwordHash  String?
  name          String?
  role          String   @default("user") // user | admin
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  subscription  Subscription?
  paymentRequests PaymentRequest[]
  smartAnalysisUsages SmartAnalysisUsage[]
  portfolioHoldings PortfolioHolding[]
  oauthAccounts OAuthAccount[]
  resetTokens   PasswordResetToken[]
  watchlistItems WatchlistItem[]
  priceAlerts   PriceAlert[]

  @@index([email])
  @@index([role])
}

// One row per (provider, external id). Email linking happens in application
// code: a verified provider email may be attached to an existing local
// account, otherwise a new passwordless User is created.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // google | facebook
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Single-use, time-boxed password reset tokens. Only the SHA-256 hash is
// stored; the raw token is shown once to the ADMIN (no mail service in this
// environment) who hands it to the user over a trusted channel.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Device-synced watchlist for signed-in users (guests keep the localStorage
// watchlist). Unique per (user, company) — toggling upserts/deletes.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
}

// Simple price alert: fires when the recorded market price crosses the
// target in the chosen direction. Evaluated server-side on price reads.
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  direction   String    // ABOVE | BELOW
  targetPrice Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([companyId, active])
}

// Investor portfolio — manual positions valued against recorded MarketPrice
// snapshots. Quantity/avgCost are user input; everything displayed derives
// from verified data (latest recorded price, never an estimate).
model PortfolioHolding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quantity  Float
  avgCost   Float // EGP per share
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   // FREE | PREMIUM | ...
  price        Float    @default(0)
  currency     String   @default("EGP")
  durationDays Int      @default(30)
  features     String   @default("[]") // JSON array of feature keys
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions  Subscription[]
  paymentRequests PaymentRequest[]

  @@index([isActive])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan       @relation(fields: [planId], references: [id])
  status        String     @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELLED | REJECTED
  startDate     DateTime?
  endDate       DateTime?
  activatedAt   DateTime?
  activatedBy   String?
  cancelledAt   DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, endDate])
  @@unique([userId])
}

model PaymentRequest {
  id                  String    @id @default(cuid())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan       @relation(fields: [planId], references: [id])
  amount              Float
  currency            String     @default("EGP")
  paymentMethod       String     @default("MANUAL_TRANSFER")
  transactionReference String?
  proofFile           String?
  status              String     @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewedAt          DateTime?
  reviewedBy          String?
  adminNote           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model SmartAnalysisUsage {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year       Int
  month      Int       // 1-12 calendar month
  usageCount Int       @default(0)
  resetAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model Setting {
  key         String   @id
  value       String
  type        String   @default("string") // string | number | boolean | json
  description String?
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// DATA QUALITY AUDIT SYSTEM (per DATA-AUDIT-PROMPT.md)
// =============================================================================

// Audit run - groups all issues from one execution
model AuditRun {
  id              String   @id @default(cuid())
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  durationSec     Int?
  type            String   @default("manual") // daily | weekly | manual
  companiesChecked Int     @default(0)
  issuesFound     Int      @default(0)
  issuesFixed     Int      @default(0)
  status          String   @default("running") // running | completed | failed

  issues          AuditIssue[]

  @@index([startedAt])
  @@index([status])
}

// Individual audit issue found during a run
model AuditIssue {
  id           String   @id @default(cuid())
  auditRunId   String
  auditRun     AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  ticker       String
  metricCode   String?
  period       String?
  category     String   // accounting | logical | temporal | cross_source | missing | outlier | provenance | sector
  severity     String   // critical | high | medium | low
  description  String
  descriptionAr String?
  currentValue String?
  expectedValue String?
  source       String?
  detectedAt   DateTime @default(now())

  status       String   @default("open") // open | auto_fixed | manually_fixed | wont_fix
  fixedAt      DateTime?
  fixedBy      String?  // user ID or "auto"
  fixNote      String?

  @@index([ticker, category, status])
  @@index([severity, status])
  @@index([auditRunId])
}

// Company-level confidence score (0-100)
model CompanyConfidenceScore {
  id            String   @id @default(cuid())
  ticker        String   @unique
  company       Company  @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  score         Int      // 0-100
  rating        String   // high | medium | low | critical
  breakdownJson String   // JSON: { coverage, violations, conflicts, anomalies, stale, sourceDiversity, isin }
  computedAt    DateTime @default(now())
  auditRunId    String

  @@index([score])
  @@index([auditRunId])
}

// Extended audit log for data quality actions (supplements existing AuditLog)
model DataQualityAuditLog {
  id           String   @id @default(cuid())
  auditRunId   String?
  actor        String   @default("system")
  action       String   // AUTO_FIX | MANUAL_FIX | IGNORE | ESCALATE | RE_RUN
  entityType   String   // Company | Issue | Metric
  entityId     String
  details      String?
  beforeValue  String?
  afterValue   String?
  createdAt    DateTime @default(now())

  @@index([auditRunId])
  @@index([entityType, entityId])
  @@index([action])
}


