// EGXANO — data model
// Principles (from master spec):
//  - Never invent financial data; every value keeps original label + source traceability
//  - Raw financial values and derived/calculated metrics are stored SEPARATELY
//  - Reports are versioned (restatements never destroy history)
//  - Every uploaded document is hashed (SHA-256) for duplicate protection
//  - Demo/synthetic data is always explicitly flagged (isDemoData)

generator client {
  provider        = "prisma-client-js"
  // Postgres (Neon / Supabase / Vercel Postgres) via the standard Prisma
  // engine — no driver adapter needed. Set DATABASE_URL to the POOLED
  // connection string on serverless (pgbouncer / -pooler host).
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String   @id @default(cuid())
  ticker        String   @unique
  isin          String?  @unique
  nameEn        String
  nameAr        String?
  sector        String // Banks | Real Estate | Industrial | Telecom | Healthcare | Food | Investment | Financial Services | Consumer | Other
  industry      String?
  listingStatus String   @default("LISTED") // LISTED | SUSPENDED | DELISTED
  isActive      Boolean  @default(true)
  isDemoData    Boolean  @default(false)
  sharesOutstanding Float? // shares in units (for EPS calculation)
  website           String?
  descriptionEn String?
  descriptionAr String?
  egxCategory   String?  // MAIN | PRIME | NILE | OTC
  sourceUrl     String?
  irUrl         String?
  lastVerifiedAt DateTime?
  originalTicker String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reports           FinancialReport[]
  values            FinancialValue[]
  calculatedMetrics CalculatedMetric[]
  events            FinancialEvent[]
  dividends         Dividend[]
  corporateActions  CorporateAction[]
  marketPrices      MarketPrice[]
  aiAnalyses        AiAnalysis[]
  priceBars         PriceBar[]
  aiReports         AiAnalysisReport[]
  aiJobs            AiAnalysisJob[]
  debtInstruments       DebtInstrument[]
  segmentDisclosures    SegmentDisclosure[]
  fairValueMovements    FairValueMovement[]
  investmentDisclosures InvestmentDisclosure[]
  relatedPartyTransactions RelatedPartyTransaction[]
  contingencies         ContingencyDisclosure[]
  shareMovements        ShareMovement[]
  dataQualityScores     DataQualityScore[]
  portfolioHoldings     PortfolioHolding[]
  confidenceScore       CompanyConfidenceScore?
  watchlistItems        WatchlistItem[]
  priceAlerts           PriceAlert[]

  @@index([sector])
  @@index([isActive])
  @@index([nameEn])
  @@index([nameAr])
}

// Market data (price feed). Kept separate from filings: a price point is a
// timestamped observation from a data source — never inferred from financials.
// When no price exists, market-dependent metrics stay DATA_UNAVAILABLE.
model MarketPrice {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf        DateTime
  price       Float
  // Liquidity columns (market-intelligence upgrade, additive):
  // session share volume from the scanner pull, and value traded (price ×
  // volume, EGP) — both nullable: illiquid names may omit volume.
  volume      Float?
  valueTraded Float?
  currency    String   @default("EGP")
  sourceName  String
  isDemoData  Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([companyId, asOf])
  @@index([companyId, asOf])
}

// One row per session for the WHOLE-MARKET intelligence snapshot (breadth,
// regime, pulse, sector rotation aggregates) — the durable history behind the
// A/D line, regime transitions and rotation deltas. The full breakdown lives
// in `snapshotJson` (validated on read); scalar columns exist for cheap SQL
// ordering/range scans. Additive table — no existing data touched.
model MarketIntelligenceDay {
  id           String   @id @default(cuid())
  day          DateTime @unique // session date (UTC midnight)
  snapshotJson String // validated MarketIntelligence JSON (versioned)
  advancing    Int // breadth counters for cheap history scans
  declining    Int
  unchanged    Int
  regime       String? // classified market regime code
  pulse        Int? // 0-100 market pulse score
  sourceName   String
  createdAt    DateTime @default(now())

  @@index([day])
}

model FinancialReport {
   id               String    @id @default(cuid())
   companyId        String
   company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
   reportType       String // ANNUAL | INTERIM | OTHER
   periodType       String // QUARTERLY | SEMIANNUAL | NINE_MONTH | ANNUAL | TTM | OTHER
   statementType    String    @default("CONSOLIDATED") // CONSOLIDATED | STANDALONE | UNKNOWN
   fiscalYear       Int
   periodLabel      String // "FY 2024" | "Q2 2025" ...
   periodStart      DateTime?
   periodEnd        DateTime
   publicationDate  DateTime?
   language         String    @default("UNKNOWN") // EN | AR | MIXED | UNKNOWN
   sourceName       String
   sourceUrl        String?
   localFileRef     String?
   fileName         String? // original upload filename
   fileHash         String? // SHA-256 of the uploaded document (duplicate protection)
   fileSize         Int?
   processingStatus String    @default("NEW_DOWNLOADED") // NEW_DOWNLOADED | PROCESSING | EXTRACTED | VALIDATED | NEEDS_REVIEW | APPROVED | FAILED | REJECTED | DELETED
   extractionMethod String? // SEED_DEMO | PDF_TEXT | PDF_ZLIB | CSV_TEXT | MANUAL_ENTRY | OCR
   parserVersion    String? // e.g. "extract@2" — pipeline version that produced the values
   extractionConfidence Float? // average extraction confidence 0..1 across values
   errorMessage     String?   // human-readable failure reason when processing fails
   uploadedBy       String?
   reviewedBy       String?
   reviewedAt       DateTime?
   approvedBy       String?
   approvedAt       DateTime?
   version          Int       @default(1)
   isRestatement    Boolean   @default(false)
   supersedesId     String?
   isDemoData       Boolean   @default(false)
   deletedAt        DateTime?
   deletedBy        String?
   notes            String?
   discoveredAt     DateTime?
   documentType     String?
   createdAt        DateTime  @default(now())
   updatedAt        DateTime  @updatedAt

   values            FinancialValue[]
   validationResults FinancialValidationResult[]
   extractionLogs    FinancialExtractionLog[]
   debtInstruments       DebtInstrument[]
   segmentDisclosures    SegmentDisclosure[]
   fairValueMovements    FairValueMovement[]
   investmentDisclosures InvestmentDisclosure[]
   relatedPartyTransactions RelatedPartyTransaction[]
   contingencies         ContingencyDisclosure[]
   shareMovements        ShareMovement[]
   dataQualityScores     DataQualityScore[]

   @@unique([companyId, periodType, periodLabel, statementType, version])
   @@index([companyId, processingStatus])
   @@index([processingStatus])
   @@index([companyId, statementType])
}

// Canonical metric registry — normalization dictionary (EN + AR aliases)
model MetricDefinition {
  id               String   @id @default(cuid())
  code             String   @unique // REVENUE, NET_PROFIT, TOTAL_ASSETS ...
  labelEn          String
  labelAr          String?
  statementType    String // INCOME_STATEMENT | BALANCE_SHEET | CASH_FLOW | OTHER
  description      String?
  aliases          String   @default("[]") // JSON string array (EN + AR aliases for extraction)
  appliesToSectors String? // JSON string array; null = applies to all sectors
  calcRole         String   @default("INPUT") // INPUT (source value) | CALCULATED (derived)
  isActive         Boolean  @default(true)
  group            String?
  displayOrder     Int?
  createdAt        DateTime @default(now())
}

model FinancialValue {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId         String
  report           FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metricCode       String // canonical code from registry
  originalLabel    String // preserved original extraction label (never destroyed)
  value            Float // as printed in the document
  currency         String    @default("EGP")
  unit             String    @default("MILLION") // UNIT | THOUSAND | MILLION | BILLION
  normalizedValue  Float // value converted to plain EGP units
  statementType    String
  group            String?
  subPeriod        String?  @default("CURRENT")
  isRestated       Boolean  @default(false)
  displayOrder     Int?
  sourceTable      Int?
  sourceRow        Int?
  sourceCol        Int?
  sourceBbox       String?
  sourcePage       Int?
  sourceText       String?
  extractionMethod String // SEED_DEMO | PDF_TEXT | CSV_TEXT | MANUAL_ENTRY | OCR
  confidence       Float     @default(1) // 0..1
  validationStatus String    @default("PENDING") // PENDING | VALID | NEEDS_REVIEW | FAILED
  validationNotes  String?
  isDemoData       Boolean   @default(false)
  originalValue     Float?    // value exactly as first extracted, before any manual correction (null = never corrected)
  isManuallyCorrected Boolean @default(false)
  correctedBy       String?
  correctedAt       DateTime?
  correctionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([reportId, metricCode, subPeriod])
  @@index([companyId, metricCode])
  @@index([validationStatus])
  @@index([companyId, statementType, group])
  @@index([companyId, group])
}

// Structured per-check validation results for a document (balance identity, PBT-tax-NI,
// sign/unit/currency checks, completeness…). Never silently alters extracted values.
model FinancialValidationResult {
  id        String   @id @default(cuid())
  reportId  String
  report    FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  checkName String   // BALANCE_SHEET_IDENTITY | PBT_TAX_NET_PROFIT | SIGN_CHECK | UNIT_CHECK | CURRENCY_CHECK | COMPLETENESS | PERIOD_CONSISTENCY | DUPLICATE_FIGURE
  category  String   // MATH | SIGN | UNIT | CURRENCY | COMPLETENESS | PERIOD
  status    String   // PASSED | WARNING | FAILED | SKIPPED
  severity  String   @default("INFO") // INFO | WARNING | CRITICAL
  details   String?
  discrepancy       Float?
  discrepancyPct    Float?
  expectedValue     Float?
  actualValue       Float?
  affectedFields    String?
  sourcePages       String?
  diagnosticReason  String?
  toleranceApplied  Float?
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([status, severity])
  @@index([checkName])
}

// Pipeline run log: every stage of document processing is recorded for traceability
model FinancialExtractionLog {
  id        String   @id @default(cuid())
  reportId  String
  report    FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  stage     String // UPLOAD | PARSE | EXTRACT | NORMALIZE | VALIDATE | FINALIZE
  level     String   @default("INFO") // INFO | WARN | ERROR
  message   String
  details   String?
  createdAt DateTime @default(now())

  @@index([reportId])
}

// AI analysis output, grounded exclusively in verified database data.
// dataHash invalidates the cache when underlying data changes.
model AiAnalysis {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodKey   String?  // anchor period used for the analysis
  content     String   // generated analysis (markdown)
  dataHash    String   // SHA-256 of the verified-data snapshot used
  inputSummary String? // JSON snapshot of the exact data given to the model (for verification)
  model       String?
  lang        String   @default("en") // language the analysis was generated in — cache is keyed per language
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

// =============================================================================
// AI ANALYSIS ENGINE v2 (production-grade reports)
// =============================================================================

// Daily OHLCV price bars feeding the deterministic technical-analysis engine.
// A bar is an observed trading session from the authorized public data source —
// sessions are never synthesized, forward-filled, or interpolated. Indicators
// that need more history than exists report "insufficient data" instead.
model PriceBar {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ts         DateTime // trading session date (UTC midnight of that session)
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float?
  currency   String   @default("EGP")
  sourceName String
  isDemoData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([companyId, ts])
}

// Versioned AI analysis report. reportKey is the DETERMINISTIC cache identity:
// sha256(companyId + financial dataHash + technicalHash + priceAsOf + engine/
// prompt/config versions + lang + depth). Identical inputs reuse the report
// across all users — page visits never trigger inference. The unique
// constraint is the last line of defense against duplicate artifacts.
model AiAnalysisReport {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportKey      String    @unique
  lang           String    @default("en") // ar | en
  status         String    @default("PENDING") // COMPLETED | FAILED (artifact rows are terminal-state only)
  content        String? // full markdown report
  sections       String? // JSON map of validated section -> markdown body
  stance         String? // bullish | cautiously_positive | neutral | bearish (extracted, null when absent)
  // --- data identity / freshness ---
  dataHash       String // sha256 of the financial snapshot used
  technicalHash  String? // sha256 of the technical snapshot used
  priceAsOf      DateTime? // latest market price date included
  financialAsOf  DateTime? // period end of the latest financial period included
  periodKey      String? // anchor financial period key
  dataCompleteness String? // JSON { financialCoveragePct, technicalCoveragePct, limitations[] }
  // --- versions ---
  promptVersion  String
  configVersion  String
  technicalVersion String
  // --- generation metadata ---
  provider       String?
  model          String?
  degraded       Boolean   @default(false) // true = rule-based fallback (no LLM)
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  wordCount      Int?
  attempt        Int       @default(0)
  error          String?
  inputSummary   String? // truncated exact input JSON (verification / audit)
  requestedBy    String? // first requesting user id (ids only, no PII)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([dataHash])
}

// Durable background-generation job. The unique reportKey prevents duplicate
// jobs for the same report identity; the lease columns (leasedBy/leaseUntil)
// plus the conditional claim make concurrent processing safe across serverless
// instances. Terminal-state rows are deleted by the worker sweep, so a later
// authorized refresh of the same identity can enqueue again.
model AiAnalysisJob {
  id          String    @id @default(cuid())
  reportKey   String    @unique
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lang        String    @default("en")
  priority    Int       @default(100) // lower = processed sooner
  status      String    @default("PENDING") // PENDING | PROCESSING | FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  leasedBy    String? // worker instance id
  leaseUntil  DateTime? // claim expiry — stale leases are re-claimed
  lastError   String?
  requestedBy String? // user id that triggered generation (audit only)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, priority, createdAt])
  @@index([companyId, status])
}

// Per-call usage accounting for cost tracking and spend caps. Never stores
// credentials or user content.
model AiProviderUsage {
  id         String   @id @default(cuid())
  provider   String // adapter id (e.g. the configured chain id — never a secret)
  model      String?
  kind       String   @default("report") // report | chat | probe
  ok         Boolean  @default(true)
  errorKind  String? // timeout | rate_limit | auth | server | parse | network | other
  tokensIn   Int?
  tokensOut  Int?
  latencyMs  Int?
  costUsdEst Float?
  companyId  String?
  reportKey  String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([kind, createdAt])
}

// Structured event trail of the analysis pipeline (lifecycle + control
// actions). Complements AuditLog with report-key granularity.
model AiAnalysisEvent {
  id        String   @id @default(cuid())
  companyId String?
  reportKey String?
  kind      String // ENQUEUED | CLAIMED | COMPLETED | FAILED | CACHE_HIT | REFRESH_RATE_LIMITED | KILL_SWITCH | SPEND_LIMIT | STALE_RECLAIMED | SWEEP
  details   String?
  actor     String? // userId or "system"
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([companyId])
}

// Derived metrics stored separately from source values, with formula version
model CalculatedMetric {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String // revenue_growth, roe, net_margin, p_b ...
  periodKey       String // "ANNUAL:2024:" | "QUARTERLY:2025:Q2"
  periodType      String
  fiscalYear      Int
  periodLabel     String
  value           Float?
  valueStatus     String   @default("OK") // OK | DATA_UNAVAILABLE | NOT_APPLICABLE | NOT_COMPUTABLE
  statusDetail    String? // human explanation when not OK
  formulaVersion  String // "revenue_growth@1"
  sourcePeriods   String   @default("[]") // JSON array of period keys used
  statementType   String   @default("CONSOLIDATED") // CONSOLIDATED | STANDALONE — never mix the two
  formula         String?
  calculationType String   @default("ANALYST_CALCULATED")
  sourceMetricCodes String?
  sourceDocumentIds String?
  isDerived       Boolean  @default(false)
  trendType       String?
  trendPeriodsCount Int?
  calculatedAt    DateTime @default(now())

  @@unique([companyId, code, periodKey, statementType])
  @@index([companyId, periodKey])
}

model FinancialEvent {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType        String // LOSS_TO_PROFIT | PROFIT_TO_LOSS | PROFIT_ACCELERATION | REVENUE_GROWTH | DEBT_REDUCTION | EQUITY_GROWTH | CASH_FLOW_IMPROVEMENT | FINANCIAL_RECOVERY | FINANCIAL_DETERIORATION | STRONG_PROFITABILITY | HIGH_ASSETS
  periodType       String
  fiscalYear       Int
  periodLabel      String
  currentPeriodKey  String
  previousPeriodKey String?
  conditions       String   @default("[]") // JSON array of matched condition details
  explanationEn    String
  explanationAr    String?
  ruleVersion      String   @default("events@1")
  detectedAt       DateTime @default(now())

  @@unique([companyId, eventType, currentPeriodKey])
  @@index([eventType])
  @@index([companyId])
}

// Corporate actions that mechanically move the share price on the ex-date:
// bonus issues (stock_dividend), splits, rights issues, cash dividends.
// The daily-change engine divides/subtracts them out so an ex-date drop is
// never reported as a market loss (e.g. CANA 0.5-share bonus 2026-11-12).
model CorporateAction {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticker           String? // EGX ticker at import time (display/debug only)
  actionType       String // stock_dividend | cash_dividend | split | rights | other
  exDate           DateTime // the day the price mechanically drops — the adjustment day
  recordDate       DateTime?
  distributionDate DateTime?
  announcementDate DateTime?
  ratioNumerator   BigInt? // shares distributed (numerator/denominator = per-share ratio)
  ratioDenominator BigInt?
  cashPerShare     Float? // EGP per share for cash dividends
  subscriptionPrice Float? // rights issue subscription price (EGP)
  currency         String   @default("EGP")
  status           String? // announced | upcoming | executed ...
  sourceName       String // FOUDALENS_CORPORATE_ACTIONS | MANUAL_ADMIN
  sourceId         String? // upstream unique id for idempotent re-imports
  isDemoData       Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, sourceName, sourceId])
  @@index([exDate])
  @@index([companyId, exDate])
}

model Dividend {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  announcementDate  DateTime?
  eligibilityDate   DateTime?
  exDividendDate    DateTime?
  distributionDate  DateTime?
  dividendPerShare  Float?
  currency          String    @default("EGP")
  dividendType      String    @default("CASH") // CASH | STOCK | SPECIAL
  status            String // ANNOUNCED | UPCOMING | ELIGIBLE | PAID | EXPIRED | CANCELLED
  // Per-distribution yield (this dividend alone): dividendPerShare ÷ last
  // cum-dividend close × 100. Reference close = trading-day close on
  // eligibilityDate (EGX: نهاية الحق) or the last trading day before exDate.
  yieldPct          Float?
  priceAtEx         Float? // reference close (split-adjusted, not div-adjusted)
  priceAtExDate     DateTime?
  priceSource       String? // e.g. YAHOO_CHART
  sourceName        String
  sourceUrl         String?
  isDemoData        Boolean   @default(false)
  notes             String? // e.g. "Distribution date not officially announced"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
}

model ScannerRule {
  id          String       @id @default(cuid())
  name        String       @unique
  nameAr      String?
  description String?
  isPreset    Boolean      @default(false)
  presetKey   String?      @unique // TURNAROUND, PROFIT_GROWTH ...
  conditions  String // JSON array: [{kind:"metric",code,operator,value}|{kind:"event",eventType}|{kind:"dividend",statuses:[]}]
  createdBy   String       @default("system")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  runs        ScannerRun[]
}

model ScannerRun {
  id                String   @id @default(cuid())
  ruleId            String?
  rule              ScannerRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleName          String
  ruleSnapshot      String // JSON conditions snapshot
  periodBasis       String // LATEST_ANNUAL | LATEST_QUARTERLY
  matchedCount      Int      @default(0)
  matchedCompanyIds String   @default("[]") // JSON array
  ranAt             DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String   @default("system")
  action     String // SEED, UPLOAD, PROCESS, EXTRACT, VALIDATE, REVIEW_APPROVE, REVIEW_EDIT, REVIEW_REJECT, CALCULATE, DETECT_EVENTS, SCAN, ADMIN_LOGIN ...
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
}

model DataSource {
  id       String   @id @default(cuid())
  name     String   @unique
  kind     String // MANUAL_UPLOAD | AUTO_COLLECTOR | EXTERNAL_API | SEED_DEMO
  config   String?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Disclosure & ingestion models (added for enriched EGX pipeline)
// ---------------------------------------------------------------------------

model DebtInstrument {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId         String
  report           FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  instrumentName   String?
  instrumentType   String
  isCurrent        Boolean  @default(false)
  isSecured        Boolean?
  currency         String   @default("EGP")
  principalAmount  Float?
  principalEgp     Float?
  interestRatePct  Float?
  maturityDate     DateTime?
  maturityYears    Float?
  sourcePage       Int?
  sourceText       String?
  extractionMethod String
  confidence       Float    @default(1)
  isDemoData       Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, reportId])
  @@index([companyId, instrumentType, isCurrent])
}

model SegmentDisclosure {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId         String
  report           FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  segmentType      String
  segmentName      String
  segmentNameAr    String?
  metricCode       String
  value            Float
  currency         String   @default("EGP")
  unit             String   @default("MILLION")
  normalizedValue  Float
  subPeriod        String   @default("CURRENT")
  sourcePage       Int?
  sourceText       String?
  extractionMethod String
  confidence       Float    @default(1)
  isDemoData       Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([reportId, segmentType, segmentName, metricCode, subPeriod])
  @@index([companyId, segmentType])
  @@index([companyId, segmentName])
}

model FairValueMovement {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId         String
  report           FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  assetClass       String
  category         String
  level            String?
  openingBalance   Float?
  purchases        Float?
  sales            Float?
  fairValueGains   Float?
  transfersIn      Float?
  transfersOut     Float?
  fxRevaluation    Float?
  closingBalance   Float?
  currency         String   @default("EGP")
  unit             String   @default("MILLION")
  sourcePage       Int?
  sourceText       String?
  extractionMethod String
  confidence       Float    @default(1)
  isDemoData       Boolean  @default(false)
  notes            String?
